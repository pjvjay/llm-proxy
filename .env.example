# ---- upstream ----
OPENAI_API_KEY=sk-your-openai-api-key-here

# ---- guardrails service ----
GUARDRAILS_URL=http://guardrails:8000
GUARDRAILS_TIMEOUT=2.0
INJECTION_MODEL_DIR=/models/prompt-guard-2-onnx
TOXICITY_MODEL_DIR=/models/granite-hap-onnx
INJECTION_POS_LABEL=1
TOXICITY_POS_LABEL=1
# 512-token windows scored per text (beyond: head + tail). DeBERTa-base on CPU
# costs ~1 s per window, so keep MAX_WINDOWS_INJECTION * that < GUARDRAILS_TIMEOUT
MAX_WINDOWS_INJECTION=2
MAX_WINDOWS_TOXICITY=8
# concurrent forward passes per model; INTRA_OP_THREADS=0 -> CPUs / MODEL_CONCURRENCY
MODEL_CONCURRENCY=2
INTRA_OP_THREADS=0

# ---- thresholds (0.0-1.0) ----
INJECTION_THRESHOLD=0.5
TOXICITY_THRESHOLD=0.5

# ---- policy: action = block|redact|warn|log ; fail = closed|open ----
TOXICITY_ACTION=block
TOXICITY_FAIL=open
PII_ACTION=redact

# ---- agentic screening (see docs/perf-report.md) ----
# which checks run on role=tool messages; action on an injection found there:
# redact = quarantine that tool output and continue, block = reject the call
TOOL_RESULT_CHECKS=injection,pii
TOOL_RESULT_INJECTION_ACTION=redact
# tool calls returned by the model (tool_policy.py)
TOOL_CALL_ACTION=block
TOOL_REQUIRE_DECLARED=1
# TOOL_ALLOWLIST=search,read_file
# TOOL_DENYLIST=
# TOOL_URL_ALLOWLIST=api.example.com,docs.example.com
# TOOL_DISABLE_CATEGORIES=path_traversal

# ---- proxy performance ----
SCAN_CACHE=1
SCAN_CACHE_MAX_BYTES=67108864
SCAN_CONTEXT_CHARS=256
PII_NLP_MODEL=blank
PII_WORKERS=2
# PII_PHONE_REGIONS=US            # ~2.3x faster PII on number-dense text; see pii.py
# GUARDRAILS_UDS=/run/guardrails/guardrails.sock
