# Copy to .env to override defaults. Everything here is OPTIONAL:
# `docker compose up --build` works without a .env file.

# ---- upstream ----
# Sent by your client as `Authorization: Bearer ...`; only needed for requests
# the firewall forwards (blocked ones never reach the upstream).
OPENAI_API_KEY=sk-your-openai-api-key-here
# Where the firewall forwards cleared requests. Local LLM (node B, GPU):
#   UPSTREAM_URL=http://llm:8000   with   docker compose --profile local-llm up
UPSTREAM_URL=https://api.openai.com

# ---- models (prepared by the model-init service into ./models) ----
#HF_TOKEN=hf_...                             # only for gated models
#INJECTION_HF_ID=protectai/deberta-v3-base-prompt-injection-v2
#INJECTION_HF_REVISION=main                  # pin a commit hash for reproducible builds (OWASP LLM03)
#TOXICITY_HF_ID=ibm-granite/granite-guardian-hap-38m
#TOXICITY_HF_REVISION=main
#REQUIRE_MODEL_MANIFEST=0                    # 1: refuse to start without a verified manifest
#MODEL_INIT_SKIP=0                           # 1: models are managed outside compose
INJECTION_POS_LABEL=1
TOXICITY_POS_LABEL=1

# ---- System 1: decision model ----
# auto: models/decision/labels.json present (your own ONNX classifier) -> that model;
#       otherwise the composite of the two stock classifiers.
DECISION_BACKEND=auto
#LABELS_USER=injection,toxicity              # extend when the decision model exposes more heads
#LABELS_TOOL=injection
#LABELS_ASSISTANT=toxicity
#DECISION_SINGLE_LABEL_ROLES=assistant
#S1_BAND_USER_INJECTION=0.20,0.80
#S1_BAND_TOOL_INJECTION=0.20,0.80
#S1_BAND_USER_TOXICITY=0.30,0.70
#S1_BAND_ASSISTANT_TOXICITY=0.30,0.70

#GUARDRAILS_TIMEOUT=5.0                      # seconds; on timeout injection fails CLOSED

# ---- thresholds (0.0-1.0) ----
INJECTION_THRESHOLD=0.5
TOXICITY_THRESHOLD=0.5

# ---- policy: action = block|redact|warn|log ; fail = closed|open ----
TOXICITY_ACTION=block
TOXICITY_FAIL=open
PII_ACTION=redact

# ---- agentic traffic (OWASP LLM01 indirect, LLM06) ----
TOOL_RESULT_ACTION=redact        # injection in a tool result: redact (withhold it) | block (the call)
TOOL_CALL_ACTION=block
#TOOL_ALLOWLIST=search,read_file,http_get
#TOOL_URL_ALLOW_DOMAINS=example.com,api.github.com
#TOOL_POLICY_FILE=/app/tool_policy.json
TOOL_READONLY=search,read_file,list_files
FIREWALL_ON_ERROR=block
#UNSCREENED_POST_ALLOW=/v1/embeddings        # POST endpoints forwarded WITHOUT screening (default: none)

# ---- OWASP LLM05 / LLM07 / LLM10 ----
OUTPUT_HANDLING_ACTION=redact    # active markup / exfil links in responses: redact | block | log
#OUTPUT_URL_ALLOW_DOMAINS=docs.example.com
SYSTEM_PROMPT_LEAK_ACTION=block  # response reproduces the system prompt: block (withhold) | log
MAX_REQUEST_BYTES=4194304
MAX_COMPLETION_TOKENS=4096       # clamp max_tokens above this (0 = off)
TOKEN_LIMIT_ACTION=clamp         # clamp | block
RATE_LIMIT_RPM=0                 # per-session requests/minute (0 = off)

# ---- evaluations / audit ----
FIREWALL_ANNOTATE=0              # 1: add the `firewall` evaluation object to every response
#AUDIT_LOG=/var/log/firewall/audit.jsonl     # default inside compose (firewall-logs volume)
#AUDIT_LOG_TEXT=0

# ---- System 2: LLM judge for uncertain cases ----
S2_MODE=off                      # off | inline | race
#S2_URL=http://judge:8000                    # with docker compose --profile system2-gpu
#S2_MODEL=ibm-granite/granite-guardian-3.2-2b
S2_TIMEOUT_MS=1500
S2_MAX_CONCURRENCY=4
S2_MAX_QUEUE=8
RISK_ESCALATE_AT=1
#ESCALATION_LOG=/var/log/firewall/escalations.jsonl

# ---- performance ----
PII_EXECUTOR=process
PII_WORKERS=2
PII_NLP_MODEL=blank
VERDICT_CACHE_SIZE=50000
VERDICT_CACHE_TTL_S=1800
GUARDRAILS_WORKERS=2             # keep GUARDRAILS_WORKERS x ORT_INTRA_THREADS <= cores
WINDOW_TOKENS=512
WINDOW_STRIDE=128
MAX_WINDOWS=8
